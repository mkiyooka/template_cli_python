
# <type>(<scope>): <subject>
#
# <body>
#
# === CONVENTIONAL COMMIT REFERENCE ===
#
# Types (必須):
#	feat:     新機能
#	fix:      バグ修正
#	docs:     ドキュメント変更
#	style:    フォーマット変更
#	refactor: リファクタリング
#	perf:     パフォーマンス改善
#	test:     テスト追加・修正
#	chore:    その他の変更
#	revert:   コミット取り消し
#
# Scopes (省略可):
#	mean: 平均計算
#	ops: 算術演算
#	cli: コマンドラインインターフェース
#	api: API
#	examples: サンプルコード
#	benchmark: ベンチマーク