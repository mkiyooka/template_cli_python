[
    {
        "label": "Debug App (main_app)",
        "adapter": "debugpy",
        "request": "launch",
        "program": "src/template_cli_python/cli.py",
        "python": ".venv/bin/python",
        "cwd": "$ZED_WORKTREE_ROOT",
    },
    {
        "label": "Debug Tests (pytest)",
        "adapter": "debugpy",
        "request": "launch",
        "module": "pytest",
        "args": ["tests/", "-v"],
        "python": ".venv/bin/python",
        "cwd": "$ZED_WORKTREE_ROOT",
        "justMyCode": false,
    },
]
